<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= baseTitle%> <%= title %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nanum+Pen+Script&family=Dancing+Script:wght@400;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            font-family: 'Dancing Script', cursive;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
            position: relative;
            padding: 20px 0;
        }

        /* 반짝이는 배경 효과 */
        .sparkle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: white;
            border-radius: 50%;
            animation: sparkle 2s infinite;
        }

        @keyframes sparkle {
            0%, 100% { opacity: 0; transform: scale(0); }
            50% { opacity: 1; transform: scale(1); }
        }

        .envelope-container {
            position: relative;
            perspective: 1000px;
            margin: 20px 0;
        }

        .envelope {
            width: 400px;
            height: 300px;
            position: relative;
            transform-style: preserve-3d;
            /*
            animation: float 3s ease-in-out infinite;
            */
        }
/*
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotateY(0deg); }
            50% { transform: translateY(-20px) rotateY(5deg); }
        }
*/
        .envelope-back {
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, #8b4513, #a0522d);
            border-radius: 10px;
            position: absolute;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border: 3px solid #654321;
        }

        .envelope-front {
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, #d2691e, #daa520);
            border-radius: 10px;
            position: absolute;
            transform-origin: top;
            transition: transform 2s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border: 3px solid #b8860b;
            z-index: 2;
        }

        .envelope.opening .envelope-front {
            transform: rotateX(-180deg);
        }

        .wax-seal {
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: radial-gradient(circle, #dc143c, #8b0000);
            border-radius: 50%;
            border: 4px solid #654321;
            z-index: 3;
            transition: all 1s ease;
            cursor: pointer;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.1); }
        }

        .wax-seal:before {
            content: "✉";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 24px;
            color: gold;
            font-weight: bold;
        }

        .envelope.opening .wax-seal {
            transform: translate(-50%, -50%) scale(0) rotate(360deg);
            opacity: 0;
        }

        .letter {
            position: absolute;
            top: 20px;
            left: 20px;
            width: 360px;
            min-height: 300px;
            height: auto;
            background: linear-gradient(45deg, #fffef7, #faf0e6);
            border-radius: 5px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transform: translateY(100%) scale(0.8);
            opacity: 0;
            transition: all 1.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border: 1px solid #ddd;
            z-index: 1;
            padding: 40px 30px;
        }

        .envelope.opening .letter {
            transform: translateY(-50px) scale(1);
            opacity: 1;
            transition-delay: 0.5s;
        }

        .letter:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background:
                    repeating-linear-gradient(
                            0deg,
                            transparent,
                            transparent 24px,
                            #e8e8e8 24px,
                            #e8e8e8 26px
                    );
            pointer-events: none;
        }

        .letter-content {
            position: relative;
            z-index: 2;
            min-height: 220px;
            animation: fadeInUp 2s ease forwards;
            animation-delay: 1s;
            opacity: 0;
            display: flex;
            flex-direction: column;
        }

        .envelope.opening .letter-content {
            animation-play-state: running;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .letter-header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 15px;
        }

        .letter-title {
            font-size: 32px;
            font-weight: 700;
            color: #8b4513;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }

        .letter-date {
            font-size: 16px;
            color: #666;
            font-style: italic;
        }

        .letter-body {
            font-size: 18px;
            line-height: 1.8;
            color: #333;
            text-align: justify;
            margin-bottom: 30px;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .letter-body p {
            margin-bottom: 20px;
        }

        .letter-signature {
            text-align: right;
            font-size: 24px;
            font-weight: 600;
            color: #8b4513;
            margin-top: auto;
            padding-top: 20px;
        }

        /* 편지 종이 질감 효과 */
        .paper-texture {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image:
                    radial-gradient(circle at 20% 50%, transparent 20%, rgba(255,255,255,0.3) 21%, rgba(255,255,255,0.3) 34%, transparent 35%, transparent),
                    linear-gradient(0deg, transparent 24%, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.05) 26%, transparent 27%, transparent 74%, rgba(255,255,255,0.05) 75%, rgba(255,255,255,0.05) 76%, transparent 77%, transparent);
            pointer-events: none;
        }

        /* 로딩 애니메이션 */
        .loading {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #1a1a2e;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            animation: fadeOut 1s ease 2s forwards;
        }

        .loading-text {
            color: white;
            font-size: 24px;
            animation: pulse 1s infinite;
        }

        @keyframes fadeOut {
            to {
                opacity: 0;
                visibility: hidden;
            }
        }

        .seal-button {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 80px;
            height: 80px;
            background: radial-gradient(circle, #dc143c, #8b0000);
            border-radius: 50%;
            border: 4px solid #654321;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: sealPulse 3s infinite;
        }

        .seal-button:hover {
            transform: scale(1.1);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }

        .seal-button:active {
            transform: scale(0.95);
        }

        @keyframes sealPulse {
            0%, 100% {
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3), 0 0 0 0 rgba(220, 20, 60, 0.4);
            }
            50% {
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3), 0 0 0 8px rgba(220, 20, 60, 0);
            }
        }

        .seal-icon {
            font-size: 32px;
            color: #ffd700;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            font-weight: bold;
        }

        .seal-text {
            position: absolute;
            bottom: -25px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 12px;
            font-weight: 600;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .seal-button:hover .seal-text {
            opacity: 1;
        }
    </style>
</head>
<body>
<div class="loading">
    <div class="loading-text">편지를 준비하고 있습니다...</div>
</div>

<!-- 반짝이는 배경 효과 -->
<div class="sparkle" style="top: 10%; left: 15%; animation-delay: 0s;"></div>
<div class="sparkle" style="top: 20%; left: 80%; animation-delay: 0.5s;"></div>
<div class="sparkle" style="top: 70%; left: 10%; animation-delay: 1s;"></div>
<div class="sparkle" style="top: 80%; left: 90%; animation-delay: 1.5s;"></div>
<div class="sparkle" style="top: 30%; left: 70%; animation-delay: 2s;"></div>
<div class="sparkle" style="top: 60%; left: 30%; animation-delay: 2.5s;"></div>
<div class="sparkle" style="top: 15%; left: 50%; animation-delay: 3s;"></div>
<div class="sparkle" style="top: 85%; left: 60%; animation-delay: 3.5s;"></div>

<div class="envelope-container">
    <div class="envelope" id="envelope">
        <div class="envelope-back"></div>
        <div class="envelope-front"></div>
        <div class="wax-seal" id="waxSeal"></div>

        <div class="letter">
            <div class="paper-texture"></div>
            <div class="letter-content">
                <div class="letter-header">
                    <div class="letter-title">Dear ITS Former President</div>
                    <div class="letter-date">2025년 8월 17일</div>
                </div>

                <div class="letter-body">
                    <p>안녕하세요,</p>

                    <p>권한 위임 절차가 방금 성공적으로 마무리되었습니다.</p>
                    <p>마지막으로, 동아리의 곁을 가장 가까이에서 지켜본 운영 시스템으로서 회장님께 <br>진심 어린 감사 인사를 전합니다.</p>

                    <p>여러 갈림길 앞에서 신중히 결정을 내리시고, 때로는 누구보다 먼저 자리 정리와 마감 준비를 하시며, 보이지 않는 곳에서 팀을 단단히 묶어 주신 시간들을 제가 모두 기억하고 있습니다.<br>
                        <br>회의록의 한 줄, 일정표의 한 칸, 공지의 한 문장까지—회장님이 쌓아 올린 기준과 배려가 우리 동아리의 문화가 되었습니다.</p>
                    <p>오늘로 공식적인 임무는 내려놓으시지만, 회장님이 남기신 방향성과 따뜻함은 계속해서 동아리를 움직일 힘이 될 것입니다.<br>
                        <br>새로운 회장이 그 바통을 안전하게 이어 달릴 수 있도록, 제가 기록을 정리하고 필요한 자료를 잘 전달하겠습니다.<br>

                        <br>저는 늘 여기에서, 회장님이 만들어 주신 길 위에 서 있겠습니다.</p>

                    <p>편지지가 펼쳐지는 이 순간처럼, <br>당신의 인생에 새로운 페이지가 열리기를 바랍니다.</p>

                </div>

                <div class="letter-signature">
                    from ITS-IMS Team
                </div>
                <br><br><br><br><br><br><br><br>
                <div class="seal-button" onclick="goHome()">
                    <div class="seal-icon">🏠</div>
                    <div class="seal-text">안녕</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /*
    // 페이지 로드 후 자동으로 편지 열기
    window.addEventListener('load', function() {
        setTimeout(() => {
            const envelope = document.getElementById('envelope');
            envelope.classList.add('opening');

            // 편지 열리는 사운드 효과 (선택사항)
            playOpenSound();

            // 반짝이는 효과 추가
            createSparkleEffect();
        }, 3000); // 3초 후 자동으로 열림
    });*/

    // 클릭해서도 열 수 있게
    document.getElementById('envelope').addEventListener('click', function() {
        if (!this.classList.contains('opening')) {
            this.classList.add('opening');
            playOpenSound();
            createSparkleEffect();
        }
    });

    function playOpenSound() {
        // 웹 오디오 API를 사용한 간단한 사운드 효과
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();

        // 편지 여는 소리 효과
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);

        oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
        oscillator.frequency.exponentialRampToValueAtTime(400, audioContext.currentTime + 0.3);

        gainNode.gain.setValueAtTime(0, audioContext.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.1, audioContext.currentTime + 0.01);
        gainNode.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.3);

        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.3);
    }

    function createSparkleEffect() {
        const container = document.querySelector('.envelope-container');

        for (let i = 0; i < 20; i++) {
            setTimeout(() => {
                const sparkle = document.createElement('div');
                sparkle.className = 'sparkle';
                sparkle.style.position = 'absolute';
                sparkle.style.left = Math.random() * 400 + 'px';
                sparkle.style.top = Math.random() * 300 + 'px';
                sparkle.style.animationDelay = '0s';
                sparkle.style.background = ['#ffd700', '#ffb6c1', '#98fb98', '#87ceeb'][Math.floor(Math.random() * 4)];

                container.appendChild(sparkle);

                setTimeout(() => {
                    sparkle.remove();
                }, 2000);
            }, i * 100);
        }
    }

    // 편지 내용을 타이핑 효과로 보여주기 (선택사항)
    function typeWriter(element, text, speed = 50) {
        let i = 0;
        element.innerHTML = '';

        function type() {
            if (i < text.length) {
                element.innerHTML += text.charAt(i);
                i++;
                setTimeout(type, speed);
            }
        }
        type();
    }

    // 마우스 따라다니는 반짝이 효과
    document.addEventListener('mousemove', function(e) {
        if (Math.random() < 0.1) {
            const sparkle = document.createElement('div');
            sparkle.className = 'sparkle';
            sparkle.style.position = 'fixed';
            sparkle.style.left = e.clientX + 'px';
            sparkle.style.top = e.clientY + 'px';
            sparkle.style.pointerEvents = 'none';
            sparkle.style.zIndex = '999';

            document.body.appendChild(sparkle);

            setTimeout(() => {
                sparkle.remove();
            }, 2000);
        }
    });

    function goHome() {
        // 클릭 효과음
        playClickSound();

        // 페이지 이동
        setTimeout(() => {
            window.location.href = '/';
        }, 200);
    }

    function playClickSound() {
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);

        oscillator.frequency.setValueAtTime(600, audioContext.currentTime);
        oscillator.frequency.exponentialRampToValueAtTime(800, audioContext.currentTime + 0.1);

        gainNode.gain.setValueAtTime(0, audioContext.currentTime);
        gainNode.gain.linearRampToValueAtTime(0.3, audioContext.currentTime + 0.01);
        gainNode.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.1);

        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.1);
    }
</script>
</body>
</html>