<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <title><%= baseTitle %><%= title %></title>
    <link href="/stylesheets/forAdmin.css" rel="stylesheet" />
    <link href="/stylesheets/forLog.css" rel="stylesheet" />
</head>
<body>
<div class="log-container">
    <header class="log-header">
        <h1>장부 열람</h1>
        <div class="month-nav">
            <% if (hasPrev) { %>
                <a class="nav-btn" href="<%= prevLink %>">← 이전 달</a>
            <% } else { %>
                <span class="nav-btn disabled">← 이전 달</span>
            <% } %>

            <span class="month-label"><%= ymLabel %></span>

            <% if (hasNext) { %>
                <a class="nav-btn" href="<%= nextLink %>">다음 달 →</a>
            <% } else { %>
                <span class="nav-btn disabled">다음 달 →</span>
            <% } %>
        </div>
    </header>

    <% if (!logs || logs.length === 0) { %>
        <div class="no-log">
            <p>해당 월의 기록이 없습니다.</p>
            <% if (!hasNext) { %>
                <p class="no-more">이후 기록은 없습니다.</p>
            <% } %>
        </div>
    <% } else { %>
        <main class="log-table-wrapper">
            <table class="log-table">
                <thead>
                <tr>
                    <th>시간</th>
                    <th>구분</th>
                    <th>물품명</th>
                    <th>이름</th>
                </tr>
                </thead>
                <tbody>
                <% logs.forEach(row => { %>
                    <tr>
                        <td><%= new Date(row.at).toLocaleString('ko-KR', { hour12: false }) %></td>
                        <td class="<%= row.action === '대여' ? 'rent' : 'return' %>"><%= row.action %></td>
                        <td><%= row.itemName %></td>
                        <td><%= row.name %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </main>
    <% } %>

    <footer class="log-footer">
        <a class="back-admin" href="/admin">← 관리자 페이지로</a>
    </footer>
</div>
</body>
</html>