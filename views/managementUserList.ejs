<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ITS-IMS <%= title %></title>
  <link href="/stylesheets/forManagementUserList.css" rel="stylesheet">
  <script src="/javascripts/forManagementUserList.js"></script>
</head>
<body>
  <div class="users-container">
    <button class="back-btn" onclick="location.href='/adminFolder/admin'">관리자 페이지로 돌아가기</button>
    
    <h1>사용자 관리</h1>
    
    <table class="user-table">
      <thead>
        <tr>
          <th>학번</th>
          <th>이름</th>
          <th>학년</th>
          <th>권한</th>
          <th>작업</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.studentNum %></td>
            <td><%= user.name %></td>
            <td><%= user.grade %></td>
            <td>
              <% if (!user.president && !user.vice_president) { %>
                <span style="color: #6c757d;">일반 사용자</span>
              <% } %>
              <% if (user.president) { %>
                <span class="permission-badge president">회장</span>
              <% } %>
              <% if (user.vice_president) { %>
                <span class="permission-badge vice-president">부회장</span>
              <% } %>
              <% if (!user.rent_perm) { %>
                      <button class="permission-badge rent-perm restore-rent-perm-btn"
                              data-student-num="<%= user.studentNum %>"
                              data-name="<%= user.name %>">
                          대여권한 없음
                      </button>
              <% } %>
            </td>
            <td>
              <% if (user.vice_president) { %>
                <button class="vicePresident-btn remove-vice"
                        onclick="showRemoveVicePresident('<%= user.studentNum %>', '<%= user.name %>')">
                  부회장 해임
                </button>
              <% } else { %>
                <button class="vicePresident-btn appoint-vice"
                        onclick="showAppointmentVicePresident('<%= user.studentNum %>', '<%= user.name %>')"
                        <%= user.president ? 'disabled' : '' %>>
                  부회장 임명
                </button>
              <% } %>

              <button class="delete-btn"
                      onclick="showDeleteModal('<%= user.studentNum %>', '<%= user.name %>', <%= user.president %>, <%= user.vice_president %>)"
                      <%= (user.president || user.vice_president) ? 'disabled' : '' %>>
                삭제
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- 🎭 평소에는 숨어있는 특별한 권한 관리 버튼 -->
    <div class="hidden-throne-access">
      <button class="secret-throne-trigger" onclick="revealThroneSection()">
        <span class="secret-text">👑</span>
        <div class="secret-tooltip">특별한 권한 관리</div>
      </button>
    </div>

    <!-- 🎭 특별한 권한 양도 버튼 섹션 (기본적으로 숨김) -->
    <div class="throne-transfer-section" id="throneSection" style="display: none;">
      <div class="section-reveal-animation">
        <button class="close-throne-section" onclick="hideThroneSection()">✕</button>

        <div class="crown-decoration">👑</div>
        <h2 class="throne-title">권한 승계의 의식</h2>
        <p class="throne-subtitle">이 결정은 매우 종요한 결정입니다. 신중히 클릭하세요.</p>

        <button class="legendary-throne-button" onclick="window.location.href='/throne/DOA'">
          <div class="button-background"></div>
          <div class="button-shine"></div>
          <div class="button-particles"></div>
          <div class="button-content">
            <span class="crown-icon">👑</span>
            <span class="button-text">회장 권한 위임</span>
            <span class="royal-symbol">⚜️</span>
          </div>
          <div class="button-glow"></div>
        </button>

        <p class="throne-warning">
          ⚠️ 한번 들어가게 된 이상 돌이킬 수 없습니다. 명심하세요.
        </p>
      </div>
    </div>
  </div>

  <!-- 삭제 확인 모달 -->
  <div id="deleteModal" class="modal">
    <div class="modal-content">
      <h3>계정 삭제 확인</h3>
      <p id="deleteMessage"></p>
      <div class="modal-buttons">
        <button class="modal-btn deleteConfirm-btn" id="confirmDelete">확인</button>
        <button class="modal-btn cancel-btn" onclick="closeModal()">취소</button>
      </div>
    </div>
  </div>

  <!-- 부회장 임명 모달 -->
  <div id="appointmentVicePresidentModal" class="modal">
    <div class="modal-content">
      <h3>부회장 임명 확인</h3>
      <p id="appointmentMessage"></p>
      <div class="modal-buttons">
        <button class="modal-btn appointmentConfirm-btn" id="confirmappointment">확인</button>
        <button class="modal-btn cancel-btn" onclick="closeModal()">취소</button>
      </div>
    </div>
  </div>

  <!-- 부회장 해임 모달 -->
  <div id="removeVicePresidentModal" class="modal">
    <div class="modal-content">
      <h3>부회장 해임 확인</h3>
      <p id="removeMessage"></p>
      <div class="modal-buttons">
        <button class="modal-btn removeConfirm-btn" id="confirmRemove">확인</button>
        <button class="modal-btn cancel-btn" onclick="closeModal()">취소</button>
      </div>
    </div>
  </div>
</body>
</html>
