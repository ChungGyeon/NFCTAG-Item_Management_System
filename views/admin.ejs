<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= baseTitle %> <%= title%></title>
  <link href="/stylesheets/forAdmin.css" rel="stylesheet">
  <script src="/javascripts/formainPage.js"></script>
</head>
<body>
<div class="test-container"> <!-- 물건 컨테이너 -->
  <main id="main-content">
    <div class="table-card">
      <h3>무슨무슨 아이템</h3>
      <ul>
        <li>
          <h2>보루펜 </h2>
        </li>
      </ul>
      <label><input type="checkbox" class="table-check"> 선택</label>
    </div>

    <% items.forEach(item => { %>
      <div class="table-card">
        <h3><%= item.itemName %></h3>
        <img id="itemImg" src="/images/<%= item.img %>" alt="이미지가 안보인다고요? 어쩌라구요">
            <h2><%= item.status %></h2>
        <label><input type="checkbox" class="table-check"> 선택</label>
        <label><button onclick="editModalOpen(this)" class="edit-btn">수정</button></label>
      </div>
    <% }) %>
  </main>
  <aside>
    <!--아래 세 개 버튼의 온클릭은 따로 함수 제작 필요 25.4.29-->
    <button class="aside adjust-button">물건 추가</button>
    <button class="aside adjust-button" onclick="deleteSelectedItems()">물건 삭제</button>
    <button class="aside adjust-button">계정 확인</button>
    <button class="aside adjust-button" onclick="OpenAddAcountModal()">계정추가</button>
  </aside>

  <section><!--계정 추가 모달-->
    <div id="AddAcountModal" class="AddAcountModal">
      <div class="AddAcountModal-content">
        <span class="close" onclick="CloseModal()">&times;</span>
        <p>계정추가</p><br>
        <div class="signUp-container">
        <form method="POST" onsubmit="signUpquery(); return false;">

          <label for="grade">학년</label>
          <input type="number" id="grade" name="grade" required>

          <label for="name">이름</label>
          <input type="text" id="name" name="name" required>

          <label for="studentnum">학번</label>
          <input type="number" id="studentnum" name="studentnum" required>

           <label for="password">비밀번호</label>
           <input type="password" id="password" name="password" required>
            <div class="AddAcountModal-buttons">
              <button type="submit">추가</button>
              </div>
            </form>
          </div>
        </div>
    </div>
   </section>



      <!--아이템 추가 모달-->
      <div id="AddItemModal" class="AddAcountModal">
        <div class="AddAcountModal-content">
          <span class="close" onclick="CloseAddItemModal()">&times;</span>
          <p>아이템 추가</p><br>
          <div class="signUp-container">
            <form method="POST" onsubmit="addItemQuery(); return false;">
              <label for="itemName">아이템 이름</label>
              <input type="text" id="itemName" name="itemName" required>
              <div class="AddAcountModal-buttons">
                <button type="submit">추가</button>
              </div>
            </form>
          </div>
        </div>
      </div>

    <section><!--아이템 수정 섹션-->
        <div id="editItemModal" class="editItemModal">
            <div class="editItemModal-content">
                <span class="close" onclick="CloseModal()">&times;</span>
                <!--여기에 자동으로 입력 됨-->
                <p class="editItemModalContainer" id ="editItemModalContainer"></p>
                <button class="editItemModalSendBtn" id="editItemModalSendBtn" onclick="updateItem()">수정</button>
            </div>
        </div>
    </section>

      <!--계정 확인 모달-->
      <div id="ViewAccountsModal" class="AddAcountModal">
        <div class="AddAcountModal-content" style="max-width: 90%; width: 900px; margin: 0 auto;">
          <span class="close" onclick="CloseViewAccountsModal()">&times;</span>
          <p style="text-align: center; font-size: 22px;">전체 계정 목록</p><br>

          <div style="overflow-x: auto; display: flex; justify-content: center;">
            <table border="1" style="width: 100%; max-width: 800px; border-collapse: collapse; text-align: center; font-size: 16px;">
              <thead style="background-color: #f2f2f2;">
              <tr>
                <th style="padding: 12px;">학번</th>
                <th style="padding: 12px;">이름</th>
                <th style="padding: 12px;">학년</th>
                <th style="padding: 12px;">대여 물품</th>
              </tr>
              </thead>
              <tbody id="account-table-body">
              <!-- JS로 채워짐 -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
</div>

<script>
// 선택된 물건 삭제 함수
//씁.... adminejs로 옳길 수 있도록
function deleteSelectedItems() {
    const selectedCheckboxes = document.querySelectorAll('.table-check:checked');

    if (selectedCheckboxes.length === 0) {
        alert('삭제할 물건을 선택해주세요.');
        return;
    }

    const selectedItems = Array.from(selectedCheckboxes).map(checkbox =>
        checkbox.getAttribute('data-item-name')
    );

    if (confirm(`선택된 ${selectedItems.length}개의 물건을 삭제하시겠습니까?`)) {
        // 서버에 삭제 요청 보내기
        fetch('/admin/delete-items', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ items: selectedItems })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('물건이 성공적으로 삭제되었습니다.');
                location.reload(); // 페이지 새로고침
            } else {
                alert('삭제 실패: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('삭제 중 오류가 발생했습니다.');
        });
    }
}
</script>
</body>
</html>

