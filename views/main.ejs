<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <!--<meta name="viewport" content="width=device-width, initial-scale=1.0" />-->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="stylesheet" href="/stylesheets/forMain.css" />
  <script src="/javascripts/forUserMainPage.js"></script>
  <title><%= baseTitle %>  <%= title%></title>
</head>
<body>
<div class="main-grid-container <%= items.some(item => item.status === 1) ? 'with-rented' : 'without-rented' %>">
  <header>
    <img class="welcome-img" src="/images/ITS-IMS.png" />
    <div class="indroduction-img-container">
      <p class="bottom-text">잠시 빌리려 왔습니다</p>
    </div>
    <a href="/users/logout" class="logout-btn">로그아웃</a>
  </header>

<% if (items.some(item => item.status === 1)) { %>
<div class="main-item1">
  <h1>빌린 품목이에요</h1>
  <div class="item-grid">
  <% items.filter(item => item.status === 1).forEach(item => { %>
    <div class="itemDetail-card rented" data-item-name="<%= item.itemName %>">
      <input type="hidden" name="status" value="<%= item.status %>">
      <p>
       <h3><%= item.itemName %></h3>
      </p>
      <p style="color: red; font-weight: bold;">
        <%= item.whoAreRent %> - 대여중
        <br>
        <span class="countdown"
              data-rent-hours="<%= item.rentToHour %>"
              data-rent-start="<%= item.date %>">
        </span>
      </p>
      <img src="/images/<%= item.img %>" alt="<%= item.itemName %>" />
      <div class="item-buttons">
        <button onclick="reserveFromServer2('<%= item.itemName %>')">반납예약</button>
        <button onclick="cancelRental2('<%= item.itemName %>')">반납 예약 취소</button>
      </div>
    </div>
  <% }) %>
  </div>
  <br><br><hr><br>
</div>
<% } %>

<div class="main-item2">
  <h1>빌릴 수 있는 거에요</h1>
  <div class="item-grid">
  <% items.filter(item => item.status === 0).forEach(item => { %>
    <div class="itemDetail-card not-rented" data-item-name="<%= item.itemName %>">
      <input type="hidden" name="status" value="<%= item.status %>">
      <h3><%= item.itemName %></h3>
      <img src="/images/<%= item.img %>" alt="<%= item.itemName %>" />
      <div class="item-buttons">
        <% if (item.isReserved) { %>
          <button class="cancel-reservation-btn" onclick="cancelReservation('<%= item.itemName %>')">예약 취소하기</button>
          <button class="reserve-btn" onclick="reserveFromServer('<%= item.itemName %>')" style="display: none;">예약하기</button>
        <% } else { %>
          <button class="cancel-reservation-btn" onclick="cancelReservation('<%= item.itemName %>')" style="display: none;">예약 취소하기</button>
          <button class="reserve-btn" onclick="reserveFromServer('<%= item.itemName %>')">예약하기</button>
        <% } %>
      </div>
    </div>
  <% }) %>
  </div>
</div>

    <!-- ✅ 대여 확정 버튼 추가 테스트용임 추후 삭제 예정-->
    <div style="text-align: center; margin-top: 30px;">
      <button onclick="location.href='/detect/startRentingItem'" style="padding: 12px 24px; font-size: 16px;">대여 확정</button>
    </div>
  </main>
</div>
</body>
</html>
