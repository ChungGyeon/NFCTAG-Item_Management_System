<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <!--<meta name="viewport" content="width=device-width, initial-scale=1.0" />-->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="stylesheet" href="/stylesheets/forMain.css" />
  <script src="/javascripts/forUserMainPage.js"></script>
  <title><%= baseTitle %>  <%= title%></title>
</head>
<body>
<div class="main-grid-container <%= items.some(item => item.status === 1) ? 'with-rented' : 'without-rented' %>">
  <header>
    <img class="welcome-img" src="/images/ITS-IMS.png" />
    <div class="indroduction-img-container">
      <p class="bottom-text">잠시 빌리려 왔습니다</p>
    </div>
    <a href="/users/logout" class="logout-btn">로그아웃</a>
    <button class="change-password-btn" onclick="showChangePasswordModal()">비밀번호 변경</button>

    <!-- 연체 정보 표시 영역 -->
    <% if (overdueInfo && overdueInfo.isRestricted) { %>
      <div class="overdue-notice">
        <% if (overdueInfo.canRestore) { %>
          <div class="overdue-alert ready-restore">
            <h4>⏰ 연체 제재 해제 가능</h4>
            <p>연체 제재 시간이 만료되었습니다.</p>
            <p>5분 이내에 자동으로 대여 권한이 복구됩니다.</p>
          </div>
        <% } else { %>
          <div class="overdue-alert active-restriction">
            <h4>🚫 대여 권한 제한 중</h4>
            <p>연체로 인해 현재 대여가 제한되어 있습니다.</p>
            <p>제재 해제까지: <span class="remaining-time" data-remaining="<%= overdueInfo.remainingTimeSeconds %>"><%= overdueInfo.remainingTimeFormatted %></span></p>
            <p class="small-text">연체 시간: <%= overdueInfo.delinquencyTime %></p>
          </div>
        <% } %>
      </div>
    <% } %>
  </header>

<% if (items.some(item => item.status === 1)) { %>
<div class="main-item1">
  <h1>빌린 품목이에요</h1>
  <div class="item-grid">
  <% items.filter(item => item.status === 1).forEach(item => { %>
    <div class="itemDetail-card rented" data-item-name="<%= item.itemName %>">
      <input type="hidden" name="status" value="<%= item.status %>">
      <p>
       <h3><%= item.itemName %></h3>
      </p>
      <p style="color: red; font-weight: bold;">
        <%= item.whoAreRent %> - 대여중
        <br>
        <span class="countdown"
              data-rent-hours="<%= item.rentToHour %>"
              data-rent-start="<%= item.date %>">
        </span>
      </p>
      <img src="/images/item_IMG/<%= item.img %>" alt="<%= item.itemName %>" />
      <% if (currentUser && item.studentNum === currentUser.studentnum) { %>
        <div class="item-buttons">
          <button onclick="reserveFromServer2('<%= item.itemName %>')">반납예약</button>
          <button onclick="cancelRental2('<%= item.itemName %>')">반납 예약 취소</button>
        </div>
      <% } %>
    </div>
  <% }) %>
  </div>
  <br><br><hr><br>
</div>
<% } %>

<div class="main-item2">
  <h1>빌릴 수 있는 거에요</h1>
  <div class="item-grid <% if (overdueInfo && overdueInfo.isRestricted) { %>overdue-restricted<% } %>">
  <% items.filter(item => item.status === 0).forEach(item => { %>
    <div class="itemDetail-card not-rented" data-item-name="<%= item.itemName %>">
      <input type="hidden" name="status" value="<%= item.status %>">
      <h3><%= item.itemName %></h3>
      <img src="/images/item_IMG/<%= item.img %>" alt="<%= item.itemName %>" />
      <div class="item-buttons">
        <% if (overdueInfo && overdueInfo.isRestricted) { %>
          <!-- 연체자는 예약 불가 -->
          <button class="reserve-btn" disabled title="연체로 인해 대여가 제한됩니다.">예약 불가</button>
        <% } else { %>
          <!-- 일반 사용자 -->
          <% if (item.isReserved) { %>
            <button class="cancel-reservation-btn" onclick="cancelReservation('<%= item.itemName %>')">예약 취소하기</button>
            <button class="reserve-btn" onclick="reserveFromServer('<%= item.itemName %>')" style="display: none;">예약하기</button>
          <% } else { %>
            <button class="cancel-reservation-btn" onclick="cancelReservation('<%= item.itemName %>')" style="display: none;">예약 취소하기</button>
            <button class="reserve-btn" onclick="reserveFromServer('<%= item.itemName %>')">예약하기</button>
          <% } %>
        <% } %>
      </div>
    </div>
  <% }) %>
  </div>
</div>

    <!-- ✅ 대여 확정 버튼 추가 테스트용임 추후 삭제 예정-->
    <div style="text-align: center; margin-top: 30px;">
      <button onclick="location.href='/detect/startRentingItem'" style="padding: 12px 24px; font-size: 16px;">대여 확정</button>
    </div>
  </main>
</div>

<!-- 비밀번호 변경 모달 -->
<div id="changePasswordModal" class="modal">
  <div class="modal-content">
    <h3>비밀번호 변경</h3>
    <form id="changePasswordForm">
      <div class="form-group">
        <label for="currentPassword">현재 비밀번호</label>
        <input type="password" id="currentPassword" name="currentPassword" required>
      </div>
      <div class="form-group">
        <label for="newPassword">새 비밀번호</label>
        <input type="password" id="newPassword" name="newPassword" required>
      </div>
      <div class="form-group">
        <label for="confirmPassword">새 비밀번호 확인</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required>
      </div>
      <div class="modal-buttons">
        <button type="submit" class="modal-btn confirm-btn">변경</button>
        <button type="button" class="modal-btn cancel-btn" onclick="closeChangePasswordModal()">취소</button>
      </div>
    </form>
  </div>
</div>

<!-- 예약 시간 선택 모달 -->
<div id="timePickerModal" class="selectTimemodal">
    <div class="selectTimemodal-content">
        <h3>예약 시간 선택</h3>

        <!-- 휠 컨테이너 -->
        <div class="picker-container">
            <ul id="wheelPicker">
                <!-- JavaScript로 동적 생성 -->
            </ul>
            <div class="highlight"></div>
        </div>

        <p>선택된 시간: <span id="selectedHourDisplay">1</span>시간</p>

        <div class="modal-buttons">
            <button type="button" onclick="confirmWheel()">확인</button>
            <button type="button" onclick="closeTimePickerModal()">취소</button>
        </div>
    </div>
</div>

</body>
</html>
