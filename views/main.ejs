<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/forMain.css" />
  <script src="/javascripts/forUserMainPage.js"></script>
  <title>ITS 물품대여소</title>
</head>
<body>
<div class="main-grid-container">
  <header>
    <img class="welcome-img" src="/images/put_out_the_picture.jpg" />
    <div class="indroduction-img-container">
      <p class="bottom-text">잠시 빌리려 왔습니다</p>
    </div>
  </header>

  <main>
    <% items.forEach(item => { %>
      <div class="itemDetail-card">
        <h3><%= item.itemName %></h3>
        <ul>
          <li>
            <img src="<%= item.img %>" alt="<%= item.itemName %>" />
          </li>
        </ul>
        <button onclick="reserveFromServer('<%= item.itemName %>')">예약하기</button>
        <button onclick="cancelReservation('<%= item.itemName %>')">예약 취소하기</button>
        <button onclick="cancelRental('<%= item.itemName %>')">대여 취소하기 (DB)</button>
      </div>
    <% }) %>

    <!-- ✅ 대여 확정 버튼 추가 테스트용임 추후 삭제 예정-->
    <div style="text-align: center; margin-top: 30px;">
      <button onclick="location.href='/detect/startRentingItem'" style="padding: 12px 24px; font-size: 16px;">대여 확정</button>
    </div>
  </main>
</div>
</body>
</html>
